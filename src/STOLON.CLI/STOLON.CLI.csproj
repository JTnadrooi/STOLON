<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<BaseOutputPath>..\..\build</BaseOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="AsitLib">
			<HintPath>..\STOLON\Assets\AsitLib.dll</HintPath>
		</Reference>
		<SLBuildAssets Include="..\STOLON\Assets\**\*.*" Exclude="..\STOLON\Assets\**\.gitkeep" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\STOLON\Assets\**\*.*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\STOLON\STOLON.csproj" />
	</ItemGroup>
	<Target Name="DepositAssets" AfterTargets="Build">
		<Copy SourceFiles="@(SLBuildAssets)" DestinationFiles="@(SLBuildAssets->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
